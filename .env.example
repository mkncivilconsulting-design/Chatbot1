# Sao chép file này thành .env (hoặc .env.local) rồi điền giá trị thật.
# KHÔNG BAO GIỜ điền key thật vào chính file .env.example này — nó được commit lên Git.

# Gemini (Tuần 2: chatbot hỏi đáp thật ở trang chủ).
# Lấy key tại https://aistudio.google.com/apikey
# Không đặt tiền tố NEXT_PUBLIC_ — key chỉ được dùng phía server trong app/api/chat/route.ts.
GEMINI_API_KEY=
# Tuỳ chọn, mặc định là gemini-3.5-flash-lite nếu để trống.
GEMINI_MODEL=

# Supabase (Tuần 3: lưu hội thoại của khách vào database).
# Hội thoại là dữ liệu riêng tư, CHỈ được truy cập từ server. Vì vậy hai biến dưới
# đây cố ý KHÔNG có tiền tố NEXT_PUBLIC_ — Next.js chỉ nhúng biến NEXT_PUBLIC_* vào
# bundle trình duyệt, nên đặt sai tiền tố là lộ secret key ra ngoài.
# Lấy tại: Supabase → Project Settings → API Keys
SUPABASE_URL=https://svyjgkezvhlhezfsfjzp.supabase.co
# Secret key, dạng sb_secret_... (KHÔNG dùng anon key hay publishable key ở đây —
# chúng bị RLS chặn, mà bảng conversations/messages cố ý không có policy nào).
SUPABASE_SECRET_KEY=

# Publishable key, dạng sb_publishable_... — CHỈ dùng cho đăng nhập cổng hồ sơ bằng
# email + mật khẩu (lib/supabase-auth.ts, proxy.ts). Mọi bước đăng nhập chạy phía
# server nên biến này cũng không có tiền tố NEXT_PUBLIC_. Dữ liệu các bảng vẫn chỉ
# đọc bằng secret key.
SUPABASE_PUBLISHABLE_KEY=

# CẢNH BÁO: đừng thêm NEXT_PUBLIC_SUPABASE_ANON_KEY để đọc hội thoại từ trình duyệt.
# Các bảng dữ liệu khách đã thu hồi toàn bộ quyền của role anon/authenticated,
# nên cách đó vừa không chạy được, vừa đi ngược yêu cầu bảo mật.

# Mật khẩu chặn tạm trang /admin (xem proxy.ts), dùng tới khi có đăng nhập thật ở Tuần 6.
# Trang admin hiển thị hội thoại riêng tư của khách nên KHÔNG được để trống:
# thiếu biến này thì /admin bị khoá hoàn toàn (trả về 503), đó là chủ ý.
ADMIN_PASSWORD=
# Tuỳ chọn: tên đăng nhập admin. Để trống thì chỉ kiểm tra mật khẩu, tên gõ gì cũng được.
ADMIN_USERNAME=

# Webhook Make.com nhận yêu cầu báo giá mới (Tuần 5).
# Lấy từ module "Custom webhook" trong kịch bản Make của bạn.
# KHÔNG gõ cứng URL này vào code: ai có nó đều gửi được dữ liệu vào kịch bản của bạn.
# Để trống thì hệ thống vẫn chạy bình thường, chỉ bỏ qua bước gửi webhook.
MAKE_WEBHOOK_URL=

# Webhook Make.com nhận thông tin khách khi admin bấm Duyệt (Tuần 5).
# Payload gồm: id, tenKhach, email, linkDangNhap.
MAKE_APPROVAL_WEBHOOK_URL=

# Link đăng nhập gửi kèm cho khách sau khi được duyệt — trỏ tới trang /login.
# Để trống thì hệ thống tự ghép NEXT_PUBLIC_SITE_URL + "/login" (nên để trống,
# để link luôn đi theo tên miền thật). Chỉ điền khi trang đăng nhập nằm ở chỗ khác.
# Đổi giá trị ở đây là đủ, không phải sửa kịch bản Make — tên trường linkDangNhap giữ nguyên.
LOGIN_URL=

# URL công khai của site: link trong email đăng nhập và link mời gửi qua Make đều ghép từ đây.
# Trên Vercel phải đổi thành tên miền thật, không thì khách nhận link localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
