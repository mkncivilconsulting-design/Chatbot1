# Sao chép file này thành .env (hoặc .env.local) rồi điền giá trị thật.
# KHÔNG BAO GIỜ điền key thật vào chính file .env.example này — nó được commit lên Git.

# Gemini (Tuần 2: chatbot hỏi đáp thật ở trang chủ).
# Lấy key tại https://aistudio.google.com/apikey
# Không đặt tiền tố NEXT_PUBLIC_ — key chỉ được dùng phía server trong app/api/chat/route.ts.
GEMINI_API_KEY=
# Tuỳ chọn, mặc định là gemini-3.5-flash-lite nếu để trống.
GEMINI_MODEL=

# Supabase (Tuần 3: lưu hội thoại của khách vào database).
# Hội thoại là dữ liệu riêng tư, CHỈ được truy cập từ server. Vì vậy hai biến dưới
# đây cố ý KHÔNG có tiền tố NEXT_PUBLIC_ — Next.js chỉ nhúng biến NEXT_PUBLIC_* vào
# bundle trình duyệt, nên đặt sai tiền tố là lộ secret key ra ngoài.
# Lấy tại: Supabase → Project Settings → API Keys
SUPABASE_URL=https://svyjgkezvhlhezfsfjzp.supabase.co
# Secret key, dạng sb_secret_... (KHÔNG dùng anon key hay publishable key ở đây —
# chúng bị RLS chặn, mà bảng conversations/messages cố ý không có policy nào).
SUPABASE_SECRET_KEY=

# CẢNH BÁO: đừng thêm NEXT_PUBLIC_SUPABASE_ANON_KEY để đọc hội thoại từ trình duyệt.
# Hai bảng conversations/messages đã thu hồi toàn bộ quyền của role anon/authenticated,
# nên cách đó vừa không chạy được, vừa đi ngược yêu cầu bảo mật.
# Khi làm đăng nhập magic link ở Tuần 6 thì mới cần key phía client, và chỉ cho auth.

# Mật khẩu chặn tạm trang /admin (xem proxy.ts), dùng tới khi có đăng nhập thật ở Tuần 6.
# Trang admin hiển thị hội thoại riêng tư của khách nên KHÔNG được để trống:
# thiếu biến này thì /admin bị khoá hoàn toàn (trả về 503), đó là chủ ý.
ADMIN_PASSWORD=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
